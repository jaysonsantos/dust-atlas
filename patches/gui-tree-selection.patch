+// tree_row_id returns the layout id of one tree row. Callers pass it
+// to `Window.scroll_to_view` to bring a node into view.
+pub fn tree_row_id(cfg_id string, node_id string) string {
+	return 'tr_${cfg_id}_${node_id}'
+}
+
+// tree_apply_reveal expands `cfg.reveal` the first time `cfg.selected`
+// changes. Later collapses by the user stay collapsed, because the
+// reveal only runs again after `selected` moves to another node.
+fn tree_apply_reveal(cfg TreeCfg, mut window Window) map[string]bool {
+	mut tree_map := window.view_state.tree_state.get(cfg.id) or {
+		map[string]bool{}
+	}
+	if cfg.reveal.len == 0 {
+		return tree_map
+	}
+	mut revealed := state_map[string, string](mut window, ns_tree_reveal, cap_tree_reveal)
+	if revealed.get(cfg.id) or { '' } == cfg.selected {
+		return tree_map
+	}
+	revealed.set(cfg.id, cfg.selected)
+	for id in cfg.reveal {
+		tree_map[id] = true
+	}
+	window.view_state.tree_state.set(cfg.id, tree_map)
+	return tree_map
+}
